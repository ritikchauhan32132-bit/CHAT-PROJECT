# ==============================================================================
# VESPERA CHAT: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Service Role Key (SERVER ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 24-Hour Expiration Engine Cron Secret (Used for protecting the /api/cron/cleanup-expired endpoint)
CRON_SECRET=vespera_cron_secret_replace_with_secure_random_string_64char

# Admin Bootstrap Secret (Used for initial one-time admin promotion without manual SQL)
ADMIN_BOOTSTRAP_SECRET=vespera_admin_bootstrap_key_change_in_production

# Application URL (for OAuth / email redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
